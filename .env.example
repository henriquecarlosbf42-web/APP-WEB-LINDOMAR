DATABASE_URL="file:./dev.db"

# Senha de acesso à área administrativa (/admin)
ADMIN_PASSWORD="troque-esta-senha"

# Número de WhatsApp da oficina (com DDI e DDD, apenas números) usado no botão
# de confirmação exibido após o envio do orçamento. Ex: 5511999999999
NEXT_PUBLIC_WHATSAPP_NUMBER="5511999999999"

# Pasta onde as fotos enviadas pelos clientes são salvas. Em produção (Render,
# Railway etc.) aponte para o disco persistente, ex: /data/uploads.
# Deixe sem definir em desenvolvimento local (usa public/uploads).
# UPLOADS_DIR="/data/uploads"
