// Prisma schema — SaaS de Orçamentos (Funilaria, Pintura, Polimento)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum QuoteStatus {
  NOVO
  EM_ANALISE
  RESPONDIDO
  APROVADO
  RECUSADO
}

model Quote {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  status    QuoteStatus @default(NOVO)

  // Etapa 1 — Dados do veículo
  vehicleBrand String
  vehicleModel String
  vehicleYear  String
  vehicleColor String
  vehiclePlate String?

  // Etapa 2 — Tipo de serviço
  services    String // lista de serviços selecionados, separados por vírgula
  description String?

  // Etapa 3 — Fotos (opcional)
  photos Photo[]

  // Etapa 4 — Dados de contato
  customerName  String
  customerPhone String
  customerEmail String?
  customerCity  String?

  // Observações internas (uso do admin)
  internalNotes String?
}

model Photo {
  id      String @id @default(cuid())
  url     String
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}
